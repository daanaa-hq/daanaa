# Jambonz Environment Configuration Template
# Copy to /opt/jambonz/config/sip-config.json and fill in your values

{
  "sip_servers": [
    {
      "domain": "voxbeam.com",
      "username": "YOUR_VOXBEAM_SIP_USERNAME",
      "password": "YOUR_VOXBEAM_SIP_PASSWORD",
      "port": 5060,
      "protocol": "udp"
    }
  ],
  "did_settings": {
    "your_did_here": {
      "route_type": "webhook",
      "webhook_url": "http://n8n:5678/webhook/nonprofit-claim",
      "description": "Nonprofit claiming via voice IVR"
    }
  }
}

# To get Voxbeam credentials:
# 1. Sign up: https://www.voxbeam.com
# 2. Add credit ($20+)
# 3. Order DID (e.g., +1-833-DAANAA-2)
# 4. Settings → SIP → Enable for SIP routing
# 5. Get SIP username + password from SIP Credentials page
