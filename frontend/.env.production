# Production defaults — override in deployment environment
VITE_API_URL=
# Set to false to hide score UI (Financial Health sort, tier badges suppressed by null API response)
VITE_ENABLE_SCORES=true

# Firebase — paste real values from Firebase Console before deploying
VITE_FIREBASE_API_KEY=placeholder
VITE_FIREBASE_AUTH_DOMAIN=placeholder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=placeholder
VITE_FIREBASE_APP_ID=placeholder
