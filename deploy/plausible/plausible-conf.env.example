# Plausible CE config — COPY to plausible-conf.env and fill in real secrets.
# The real plausible-conf.env is gitignored (never commit secrets).
#
# Generate secrets:
#   SECRET_KEY_BASE: openssl rand -base64 48
#   TOTP_VAULT_KEY:  openssl rand -base64 32
#   POSTGRES_PASSWORD: openssl rand -base64 24

BASE_URL=https://stats.daanaa.org
SECRET_KEY_BASE=__generate_me__
TOTP_VAULT_KEY=__generate_me__
POSTGRES_PASSWORD=__generate_me__

# First run: set to false to create the admin account, then flip to true and
# `docker compose up -d` again to lock registration.
DISABLE_REGISTRATION=true
