# n8n Environment Configuration Template
# Copy to /opt/n8n/.env and fill in your values

# n8n UI Authentication
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=akbar
N8N_BASIC_AUTH_PASSWORD=secure_password_change_me

# n8n Server
N8N_HOST=localhost
# For production: N8N_HOST=n8n.daanaa.org
N8N_PORT=5678
N8N_PROTOCOL=http
# For production: N8N_PROTOCOL=https

# Webhooks (must be externally accessible)
WEBHOOK_URL=http://localhost:5678/
# For production: WEBHOOK_URL=http://n8n.daanaa.org/

# Database (PostgreSQL)
DB_TYPE=postgres
DB_POSTGRES_HOST=postgres
DB_POSTGRES_USER=n8n
DB_POSTGRES_PASSWORD=n8n_secure_password_change_me
DB_POSTGRES_DB=n8n
DB_POSTGRES_PORT=5432

# Environment
NODE_ENV=production

# Execution Mode
N8N_EXECUTION_MODE=queue

# Optional: Logging
LOG_LEVEL=info

# Optional: Max execution time (ms)
N8N_WORKFLOW_DEFAULT_TIMEOUT=300

# Gmail API Credentials
# (Set up via n8n UI: Credentials → Gmail → Authenticate)
# No env vars needed; use OAuth

# Chatwoot API Token
# (Generate in Chatwoot: Settings → API Tokens)
# Store securely; reference in n8n workflow credentials

# Metabase API Key
# (Generate in Metabase: Settings → Admin → API Tokens)
# Store securely; reference in n8n workflow credentials
