# Chatwoot Environment Configuration Template
# Copy to /opt/chatwoot/.env and fill in your values

# Database
POSTGRES_PASSWORD=chatwoot_secure_password_change_me

# Rails
RAILS_ENV=production
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=$(openssl rand -hex 32)

# Redis
REDIS_URL=redis://redis:6379

# URLs
FRONTEND_URL=http://localhost:3000
# For production, change to: https://chatwoot.daanaa.org

# Email
MAILER_SENDER_EMAIL=support@daanaa.org

# Optional: S3 for file uploads (not needed initially)
# ACTIVE_STORAGE_SERVICE=amazon
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_REGION=us-east-1
# AWS_BUCKET=daanaa-chatwoot

# Optional: Sentry for error tracking
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
