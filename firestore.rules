rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== USER WALLET DATA =====
    // User can read/write their own wallet data
    match /{uid}/saved_organizations/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    match /{uid}/funded_log/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    match /{uid}/volunteer_hour_logs/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    match /{uid}/volunteer_hour_confirmations/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    match /{uid}/consent_records/{document=**} {
      allow read, write: if request.auth.uid == uid;
    }

    // ===== NONPROFIT VERIFICATION RECORDS =====
    // P0-SEC-001 (2026-08-08). Previously: `allow read, write: if
    // request.auth.uid != null`, which let ANY authenticated user read and write
    // EVERY nonprofit's verification records across the whole wildcard subtree —
    // including verifying an organization they have no relationship to.
    //
    // Client access is now denied outright rather than narrowed, because no
    // client legitimately needs it: verification records live in the SQLite
    // `nonprofit_verifications` table behind daanaa_api.py, where writes are
    // gated by _authorize_claimant() and public reads are an explicit, limited
    // projection. Nothing in this repository reads or writes a Firestore
    // collection of this name. Trusted server paths use the Firebase Admin SDK,
    // which bypasses these rules, so denial here costs no legitimate function.
    //
    // This is deny-by-default (mandate: "unspecified access is denied"). If a
    // client-side verification workflow is ever built, it must be added here
    // explicitly, per-organization, and must not permit self-verification or
    // client assignment of privileged/approval/reviewer/audit fields.
    match /nonprofit_verifications/{nonprofit_id}/{document=**} {
      allow read, write: if false;
    }

    // ===== AUDIT LOGS =====
    // Only backend can write audit logs, users can read their own
    match /{uid}/audit_logs/{document=**} {
      allow read: if request.auth.uid == uid;
      allow write: if false;  // Backend writes via admin SDK
    }
  }
}
